# Modos de execução (padrões rodam sem nenhuma credencial)
LLM_PROVIDER=fake   # fake | gemini
DATA_SOURCE=demo    # demo | live
CHANNEL=console     # console | whatsapp

# Pluggy
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# IDs dos itens do MeuPluggy, separados por vírgula
PLUGGY_ITEM_IDS=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Entre aspas, com \n escapados
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google AI
GEMINI_API_KEY=
GEMINI_MODEL=

# WhatsApp Config
OWNER_PHONE_NUMBER=5579999999999

# Opcional
TZ=America/Sao_Paulo
LOG_LEVEL=info
SYNC_CRON=0 7,19 * * *
